# Copy to .env.local and set to switch the frontend onto a real backend.
#
# Unset or empty -> the in-browser mock in src/lib/mockBackend.ts runs, and the
# app is fully usable with no backend at all.
#
# Set -> every screen reads from this origin over HTTP, and live agent progress
# arrives over SSE. The contract the backend must satisfy is in
# BACKEND_CONTRACT.md.
#
# NOTE: anything in a VITE_-prefixed variable is bundled into the browser build
# and is public. Never put a StraitsX key or any other secret here.

VITE_API_BASE_URL=http://localhost:8787
