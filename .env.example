# Copy to .env at the repo root. Never commit .env — this repo is public.
# Only ISSUER, CARD_API_BASE and ALLOWED_NETWORK differ between mock/sandbox/production.

API_PORT=8787
DEMO_STORE_PORT=4030

CHAIN_ID=43113
ALLOWED_NETWORK=eip155:43113
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
XSGD_ADDRESS=0xd769410dc8772695a7f55a304d2125320a65c2a5   # lowercase; viem rejects a bad EIP-55 checksum
BUNDLER_URL=https://public.pimlico.io/v2/43113/rpc

CARD_API_BASE=https://card.straitsx.ai/sandbox/cardapi
CARD_MCP_URL=https://card.straitsx.ai/sandbox/mcp

ISSUER=mock                    # mock | straitsx   <- the whole rail swap
DEMO_STORE_URL=http://127.0.0.1:4030

SPEND_KEY_MODE=local           # kms | local
AWS_REGION=ap-southeast-1
KMS_KEY_ID=
SPEND_PRIVATE_KEY=             # local fallback only — throwaway testnet key
OWNER_PRIVATE_KEY=             # demo user sudo key — throwaway testnet key

CARDHOLDER_NAME=Happy Agent
MIN_CARD_CENTS=500
MAX_CARD_CENTS=3000
CARD_HEADROOM_CENTS=0
PRICE_TOLERANCE_BPS=200
RESERVATION_TTL_MS=900000
CHAIN_STALE_MS=60000
RAIL_BUCKET_CAPACITY=8
RAIL_BUCKET_REFILL_MS=60000
RUN_LIVE_CONTRACT_TEST=0

DATABASE_URL=file:./happy.db
SERVICE_TOKEN=dev-token-change-me

# apps/web
