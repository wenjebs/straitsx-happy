# Copy to .env at the repo root. Never commit .env — this repo is public.
# Only ISSUER, CARD_API_BASE and ALLOWED_NETWORK differ between mock/sandbox/production.

API_PORT=8787
DEMO_STORE_PORT=4030

CHAIN_ID=43113
ALLOWED_NETWORK=eip155:43113
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
XSGD_ADDRESS=0xd769410dc8772695a7f55a304d2125320a65c2a5   # lowercase; viem rejects a bad EIP-55 checksum
BUNDLER_URL=https://public.pimlico.io/v2/43113/rpc

CARD_API_BASE=https://card.straitsx.ai/sandbox/cardapi
CARD_MCP_URL=https://card.straitsx.ai/sandbox/mcp

ISSUER=mock                    # mock | straitsx   <- the whole rail swap
DEMO_STORE_URL=http://127.0.0.1:4030

SPEND_KEY_MODE=local           # kms | local
AWS_REGION=ap-southeast-1
KMS_KEY_ID=
AGENT_PRIVATE_KEY=             # local fallback only — throwaway testnet key
OWNER_PRIVATE_KEY=             # demo user sudo key — throwaway testnet key

MIN_CARD_SGD=5
MAX_CARD_SGD=30
SLIPPAGE_BPS=200
CHAIN_STALE_MS=60000

DATABASE_URL=file:./happy.db
SERVICE_TOKEN=dev-token-change-me

# apps/web

# backend/ — the concierge API used by frontend/
# Memory is convenient locally; AWS deployment sets dynamodb.
PORT=8787
DATA_STORE=memory
DYNAMODB_TABLE=
DYNAMODB_ENDPOINT=
FRONTEND_ORIGIN=http://localhost:4040
PUBLIC_BASE_URL=http://localhost:8787

# Happy owns planning. Keep local for the no-key walkthrough; after creating a
# fresh server-side key, change PLANNER_MODE to openai.
PLANNER_MODE=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# Scouts remain a separate replaceable provider for your friends' agents.
SCOUT_MODE=local
AGENT_API_BASE_URL=
AGENT_API_TOKEN=
AGENT_CALLBACK_TOKEN=

CARD_MODE=local
CARD_API_BASE_URL=
CARD_API_TOKEN=

PURCHASE_AGENT_MODE=local
PURCHASE_AGENT_API_BASE_URL=
PURCHASE_AGENT_API_TOKEN=
PURCHASE_CALLBACK_TOKEN=

PAYMENT_MIN_MINOR=500
PAYMENT_MAX_MINOR=3000
PAYMENT_ATTEMPTS_PER_LISTING=2
